FROM node:20-slim AS build

WORKDIR /app

# Instalar OpenSSL necessária para o Prisma
RUN apt-get update -qq && apt-get install -y -qq libssl-dev 2>/dev/null

# Copiar package.json e instalar dependências
COPY backend/package.json backend/package-lock.json ./
RUN npm install

# Copiar Prisma schema e gerar client
COPY backend/prisma ./prisma
RUN npx prisma generate --schema=prisma/schema.prisma 2>/dev/null

# Copiar tsconfig
COPY tsconfig.json ./

EXPOSE 3333

CMD ["npm", "run", "dev", "--", "--preserve-symlinks"]
