# === Pizzaria System - Variáveis de Ambiente ===

# Porta do servidor (opcional, padrão: 3333)
PORT=3333

# URL de conexão com o banco PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/pizzaria?schema=public"

# Origens permitidas no CORS (separadas por vírgula para múltiplas origens)
# Padrão: http://localhost:3000
CORS_ORIGIN="http://localhost:3000"
